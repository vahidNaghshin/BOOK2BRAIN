POSTGRES_DB=book2brain
POSTGRES_USER=book2brain
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Where original uploaded files are stored. Relative paths are resolved from the
# project root. Point this outside the repository (e.g. /var/lib/book2brain) if you like.
STORAGE_ROOT=storage
# Maximum accepted upload size in MB (default 100). The app enforces this itself.
# Streamlit has its own cap, set in .streamlit/config.toml (maxUploadSize, default 100):
# raise both together to accept larger files.
MAX_UPLOAD_SIZE_MB=100
LOG_LEVEL=INFO

# --- Document processing (all optional; defaults shown) ---
# Tesseract language(s), e.g. eng or eng+deu. The language data must be installed.
OCR_LANGUAGE=eng
# Resolution pages are rendered at before OCR (72-600). Higher is slower but can read small print.
OCR_DPI=300
# Set to false to skip scanned pages instead of running OCR.
OCR_ENABLED=true
# A page with fewer letters/digits than this (and a page image) is treated as scanned.
OCR_MIN_TEXT_CHARS=25
# A page whose extracted text is more than this fraction garbled is sent to OCR (0-1).
OCR_MAX_GARBLED_RATIO=0.3
# OCR text below this confidence (0-100) never replaces text that was already extracted.
OCR_MIN_CONFIDENCE=30
# A document with fewer extracted characters than this is not marked as completed.
MIN_CONTENT_CHARACTERS=20
# A processing run with no result after this many minutes is treated as interrupted.
PROCESSING_STALE_MINUTES=120

# --- Equation extraction (all optional; defaults shown) ---
# Master switch. When false, equations are neither detected nor recognized.
EQUATION_EXTRACTION_ENABLED=true
# Docling's formula model turns PDF formula regions into LaTeX (about 600 MB, downloaded on first use).
FORMULA_ENRICHMENT_ENABLED=true
# cpu + float32 is about 13x faster than Docling's default on Apple Silicon (MPS fails on this model).
FORMULA_ENRICHMENT_DEVICE=cpu
FORMULA_ENRICHMENT_DTYPE=float32
# Math OCR recovers formulas the first route could not, including equations that are images.
MATH_OCR_ENABLED=true
# docling (default, no extra install) or pix2text (optional, see README: its dependencies conflict).
MATH_OCR_ENGINE=docling
# Model output with a reported confidence below this (0-1) is marked "uncertain".
EQUATION_MIN_CONFIDENCE=0.70
# Keep an image of every recognized region, shown next to the LaTeX for review.
EQUATION_STORE_CROPS=true
EQUATION_CROP_DPI=200
# Layout analysis often labels equations as pictures: try math OCR on small, wide pictures
# and keep only those that read as mathematics. Each try costs a few seconds, so it is capped.
EQUATION_SCAN_PICTURES=true
EQUATION_SCAN_PICTURES_MAX=300

# --- Book structure and passages (all optional; defaults shown) ---
# A heading candidate scoring at least ACCEPT is a confident heading. Between REJECT and ACCEPT it is
# kept but flagged "ambiguous" (and sent to the LLM, if enabled). Below REJECT it stays body text.
STRUCTURE_HEADING_ACCEPT_THRESHOLD=0.70
STRUCTURE_HEADING_REJECT_THRESHOLD=0.45
# Copy a detected subtitle/author into EMPTY book fields (never over what you entered).
STRUCTURE_FILL_EMPTY_BOOK_METADATA=false
STRUCTURE_METADATA_MIN_CONFIDENCE=0.8
# Optional LLM for ambiguous headings: any OpenAI-compatible chat endpoint (hosted or local).
# Off by default: nothing is sent anywhere unless you enable it.
STRUCTURE_LLM_ENABLED=false
# STRUCTURE_LLM_BASE_URL=https://api.openai.com/v1
# STRUCTURE_LLM_MODEL=
# STRUCTURE_LLM_API_KEY=
STRUCTURE_LLM_TIMEOUT_SECONDS=60
STRUCTURE_LLM_MAX_CANDIDATES=60
STRUCTURE_LLM_BATCH_SIZE=15
# Passage sizes in tokens, and the share of the target repeated at the start of the next passage.
PASSAGE_TARGET_TOKENS=750
PASSAGE_MIN_TOKENS=500
PASSAGE_MAX_TOKENS=1000
PASSAGE_OVERLAP_RATIO=0.12
# approx (characters / PASSAGE_CHARS_PER_TOKEN), words, whitespace, or tiktoken (pip install tiktoken).
PASSAGE_TOKENIZER=approx
PASSAGE_CHARS_PER_TOKEN=4
TIKTOKEN_ENCODING=cl100k_base
# Tables larger than this many times PASSAGE_MAX_TOKENS are split between rows (smaller ones stay whole).
PASSAGE_TABLE_SPLIT_FACTOR=2

# Optional: database used by the test suite. Defaults to the app database name + "_test".
# The name must contain "_test".
# TEST_DATABASE_URL=postgresql+psycopg://book2brain:change-me@localhost:5432/book2brain_test
DATABASE_URL=postgresql+psycopg://book2brain:change-me@localhost:5432/book2brain
