POSTGRES_DB=book2brain
POSTGRES_USER=book2brain
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Where original uploaded files are stored. Relative paths are resolved from the
# project root. Point this outside the repository (e.g. /var/lib/book2brain) if you like.
STORAGE_ROOT=storage
# Maximum accepted upload size in MB (default 100). The app enforces this itself.
# Streamlit has its own cap, set in .streamlit/config.toml (maxUploadSize, default 100):
# raise both together to accept larger files.
MAX_UPLOAD_SIZE_MB=100
LOG_LEVEL=INFO

# Optional: database used by the test suite. Defaults to the app database name + "_test".
# The name must contain "_test".
# TEST_DATABASE_URL=postgresql+psycopg://book2brain:change-me@localhost:5432/book2brain_test
DATABASE_URL=postgresql+psycopg://book2brain:change-me@localhost:5432/book2brain
